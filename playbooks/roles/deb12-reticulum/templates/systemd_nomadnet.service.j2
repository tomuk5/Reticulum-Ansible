[Unit]
Description=Nomadnet Daemon
After=multi-user.target
BindsTo=rnsd.service

[Service]
Type=simple
Restart=always
RestartSec=3
User={{ reticulum_rnsd_service_user }}
ExecStart=nomadnet -d --config "{{ reticulum_nomadnet_config_path }}" --rnsconfig "{{ reticulum_rnsd_config_path }}"

[Install]
WantedBy=multi-user.target
